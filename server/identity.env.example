# FT-WEB-005 server configuration. Do not use VITE_ for provider keys.
# Wallet cookies expire on every server restart; accounts/characters/world data persist.
# Production is the default. Missing origin/allowlist/key fails closed.
FT_ENV=production
FT_PUBLIC_ORIGIN=https://your-freetower.example
# Optional additional explicit same-site origins, separated by commas.
FT_ALLOWED_ORIGINS=
FT_ENABLE_DEV_IDENTITY=false
FT_ENABLE_LEGACY_AUTH=false
UNISAT_FRACTAL_API_KEY=
# Exact confirmed Fractal inscription IDs, comma-separated; no collection guessing.
FT_CHARACTER_INSCRIPTION_ALLOWLIST=

# Local test/dev example (set only intentionally):
# FT_ENV=development
# FT_PUBLIC_ORIGIN=http://localhost:4318
# FT_ALLOWED_ORIGINS=http://127.0.0.1:4318
# FT_ENABLE_DEV_IDENTITY=true
# FT_ENABLE_LEGACY_AUTH=false

# Local real-wallet ownership evidence only; cannot grant Character eligibility.
# Always disabled in production, even when set to true. No DEV wallet fallback.
FT_ENABLE_OWNERSHIP_ACCEPTANCE=false

# Public staging only. Runtime must use canonical FREETOWER_ENV=staging,
# HTTPS FREETOWER_PUBLIC_ORIGIN and PostgreSQL DATABASE_URL (supplied separately).
# No automatic test Character acceptance; leave unset to keep it disabled.
# This reserved asset is never admitted by FT_CHARACTER_INSCRIPTION_ALLOWLIST.
# FREETOWER_ENV=staging
# FREETOWER_STAGING_CHARACTER_INSCRIPTION_ID=812e807292195582243f7370fde8155dd1e21ff6cb9841bc1cf543a2c0859f92i0
# Production does not inherit staging sessions, characters or this setting.
