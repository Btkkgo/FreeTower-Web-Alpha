# FT-WEB-005 server configuration. Do not use VITE_ for provider keys.
# Wallet cookies expire on every server restart; accounts/characters/world data persist.
# Production is the default. Missing origin/allowlist/key fails closed.
FT_ENV=production
FT_PUBLIC_ORIGIN=https://your-freetower.example
# Optional additional explicit same-site origins, separated by commas.
FT_ALLOWED_ORIGINS=
FT_ENABLE_DEV_IDENTITY=false
FT_ENABLE_LEGACY_AUTH=false
UNISAT_FRACTAL_API_KEY=
# Exact confirmed Fractal inscription IDs, comma-separated; no collection guessing.
FT_CHARACTER_INSCRIPTION_ALLOWLIST=

# Local test/dev example (set only intentionally):
# FT_ENV=development
# FT_PUBLIC_ORIGIN=http://localhost:4318
# FT_ALLOWED_ORIGINS=http://127.0.0.1:4318
# FT_ENABLE_DEV_IDENTITY=true
# FT_ENABLE_LEGACY_AUTH=false
